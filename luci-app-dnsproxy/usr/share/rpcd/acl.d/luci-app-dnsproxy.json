{
    "luci-app-dnsproxy": {
        "description": "Grant access to DNSproxy configuration",
        "read": {
            "file": {
                "/etc/config/dnsproxy": ["read"],
                "/lib/apk/db/installed": ["read"],
                "/proc/net/tcp": ["read"],
                "/proc/net/tcp6": ["read"],
                "/proc/net/udp": ["read"],
                "/proc/net/udp6": ["read"]
            },
            "ubus": {
                "file": ["read", "exec"],
                "luci": ["getProcessList"],
                "rc": ["init"],
                "service": ["list"],
                "uci": ["get", "set", "commit"]
            },
            "uci": ["dnsproxy"]
        },
        "write": {
            "file": {
                "/etc/config/dnsproxy": ["write"]
            },
            "ubus": {
                "file": ["write", "exec"],
                "luci": ["getProcessList"],
                "rc": ["init"],
                "service": ["list"],
                "uci": ["get", "set", "commit"]
            },
            "uci": ["dnsproxy"]
        }
    }
}
