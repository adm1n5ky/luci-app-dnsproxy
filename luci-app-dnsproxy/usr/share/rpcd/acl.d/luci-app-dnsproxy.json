{
    "luci-app-dnsproxy": {
        "description": "Grant access to DNSproxy configuration",
        "read": {
            "file": {
                "/etc/config/dnsproxy": ["read"],
                "/lib/apk/db/installed": ["read"]
            },
            "ubus": {
                "file": ["read", "exec"],
                "rc": ["init"],
                "service": ["list"],
                "uci": ["get", "set", "commit"]
            },
            "uci": ["dnsproxy"]
        },
        "write": {
            "file": {
                "/etc/config/dnsproxy": ["write"]
            },
            "ubus": {
                "file": ["write", "exec"],
                "rc": ["init"],
                "service": ["list"],
                "uci": ["get", "set", "commit"]
            },
            "uci": ["dnsproxy"]
        }
    },
    "luci": {
        "access": {
            "exec": {
                "/sbin/logread": ["exec"]
            }
        }
    }
}
